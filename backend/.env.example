# Copy to .env for local overrides. In each datacenter these come from the platform's environment.
BCW_DATACENTER=local

# memory (local only) or mongo
BCW_SESSION_STORE=memory
BCW_MONGODB_URI=mongodb://127.0.0.1:27017
BCW_MONGODB_DB=bc_workflows
# 30 days
BCW_SESSION_TTL_SECONDS=2592000

BCW_OBCV_MODE=mock
BCW_OBCV_MOCK_DELAY_MS=1500

BCW_BC_TEAM_URL=https://example.invalid/banker-connection
BCW_AUTH_REQUIRED=false
BCW_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
BCW_LOG_LEVEL=INFO
